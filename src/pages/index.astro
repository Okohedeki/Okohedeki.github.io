---
import Base from '../layouts/Base.astro';
import { site, url, isExternal } from '../data/site';

// Relative links inside the HTML lines (e.g. "projects#riffborn") need the deploy base.
const withBase = (html: string) =>
  html.replace(/href="(?!https?:|mailto:|#|\/)([^"]*)"/g, (_, p: string) => `href="${url(p)}"`);
---

<Base bare>
  <main class:list={['home', { 'no-photo': !site.photo }]}>
    {
      site.photo && (
        <figure class="home-photo">
          <img src={url(site.photo)} alt={site.photoAlt} />
        </figure>
      )
    }

    <div class="home-body">
      <div class="home-inner">
        <h1>{site.name}</h1>

        <div class="intro">
          {
            site.lines.map((l) => (
              <p>
                <span class="label">{l.label}:</span> <Fragment set:html={withBase(l.html)} />
              </p>
            ))
          }
        </div>

        <ul class="home-nav">
          {
            site.links.map((l) => {
              const ext = isExternal(l.href);
              return (
                <li>
                  <a href={ext ? l.href : url(l.href)}>
                    {l.label} {ext ? '↗' : '→'}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="home-rule"></div>

        {site.currently && <p class="home-meta">currently: {site.currently}</p>}
        <button class="text-toggle" type="button" data-theme-toggle data-long="1">
          switch to dark →
        </button>
      </div>
    </div>
  </main>
</Base>
