---
import Base from '../layouts/Base.astro';
import { site, url, isExternal } from '../data/site';

// Relative links inside the HTML lines (e.g. "projects#riffborn") need the deploy base.
const withBase = (html: string) =>
  html.replace(/href="(?!https?:|mailto:|#|\/)([^"]*)"/g, (_, p: string) => `href="${url(p)}"`);
const navLinks = site.links.filter((l) => l.label !== 'Email');
---

<Base bare>
  <main class="landing">
    <section class="hero" aria-label="Icarus, a pixel-art animation">
      <header class="hero-bar">
        <a class="hero-name" href={url('')}>{site.name}</a>
        <nav class="hero-nav" aria-label="Main">
          {
            navLinks.map((l) => {
              const ext = isExternal(l.href);
              return <a href={ext ? l.href : url(l.href)}>{l.label}</a>;
            })
          }
        </nav>
      </header>

      <div class="hero-stage">
        <div class="hero-frame" data-icarus></div>
      </div>

      <p class="hero-caption">Icarus. Drawn entirely in code.</p>
    </section>

    <section class="about">
      <div class="about-inner">
        <div class="intro">
          {
            site.lines.map((l) => (
              <p>
                <span class="label">{l.label}:</span> <Fragment set:html={withBase(l.html)} />
              </p>
            ))
          }
        </div>

        <ul class="home-nav">
          {
            site.links.map((l) => {
              const ext = isExternal(l.href);
              return (
                <li>
                  <a href={ext ? l.href : url(l.href)}>
                    {l.label} {ext ? '↗' : '→'}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <div class="home-rule"></div>

        {site.currently && <p class="home-meta">Currently: {site.currently}</p>}
        <button class="text-toggle" type="button" data-theme-toggle data-long="1">
          Switch to dark mode →
        </button>
      </div>
    </section>
  </main>
  <script is:inline src={url('icarus.js')}></script>
</Base>
