---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';

const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const fmt = (d: string) => {
  const [y, m] = d.split('-');
  return `${months[Number(m) - 1]} ${y}`;
};
---

<Base title="Projects" description="Side projects by Edeki Okoh: agent tooling, audio and video experiments, and a few games.">
  <main class="page">
    <h1>Projects</h1>
    <p class="lede">
      Things I've built outside work: agent tooling, audio and video experiments, a few games. Newest first.
    </p>

    <div class="cards">
      {
        projects.map((p) => {
          const Tag = p.url ? 'a' : 'div';
          return (
            <Tag class="card" id={p.id} href={p.url}>
              <div class="card-head">
                <h2>
                  {p.name}
                  {p.url && <span class="arrow" aria-hidden="true">↗</span>}
                </h2>
                {p.status && <span class="status">{p.status}</span>}
                <time datetime={p.date}>{fmt(p.date)}</time>
              </div>
              <p>{p.blurb}</p>
            </Tag>
          );
        })
      }
    </div>
  </main>
</Base>
