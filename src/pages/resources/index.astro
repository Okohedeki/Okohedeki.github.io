---
import Base from '../../layouts/Base.astro';
import { resources } from '../../data/resources';
import { url } from '../../data/site';
---

<Base title="Resources" description="Prompts you can paste into Claude Code, from Edeki Okoh's own setup.">
  <main class="page">
    <h1>Resources</h1>
    <p class="lede">
      Prompts from my own setup that you can paste into Claude Code. Each one does one job and explains what it's doing as it goes.
    </p>

    <div class="cards">
      {
        resources.map((r) => (
          <a class="card" href={url(`resources/${r.slug}`)}>
            <p class="eyebrow">{r.category}</p>
            <h2>
              {r.title}
              <span class="arrow" aria-hidden="true">→</span>
            </h2>
            <p>{r.summary}</p>
          </a>
        ))
      }
    </div>
  </main>
</Base>
